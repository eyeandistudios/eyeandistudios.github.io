  .updated{color:var(--text-dim); font-size:0.85rem; margin-bottom:48px; font-family:'JetBrains Mono',monospace;}

  h2{font-size:1.15rem; color:var(--amber); margin-top:40px; margin-bottom:14px;}
  p{color:var(--text); margin-bottom:14px; font-size:0.98rem;}
  p.dim{color:var(--text-dim);}
  ul{margin:0 0 14px 20px; color:var(--text);}
  li{margin-bottom:8px; font-size:0.98rem;}

  .divider{border:none; border-top:1px solid var(--line); margin:48px 0;}

  footer{padding:40px 0; border-top:1px solid var(--line);}
  .foot-meta{color:var(--text-dim); font-size:0.78rem; font-family:'JetBrains Mono',monospace; letter-spacing:0.04em;}
